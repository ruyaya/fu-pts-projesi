<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:text="YENİ ARAÇ KAYDI"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:cardBackgroundColor="#1E1E24"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/ivAracGorseli"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_camera" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E24"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/etPlaka"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#121212"
                android:hint="Plaka"
                android:paddingHorizontal="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:layout_marginBottom="15dp"
                android:textAllCaps="true" />

            <EditText
                android:id="@+id/etSahip"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#121212"
                android:hint="Araç Sahibi"
                android:paddingHorizontal="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:layout_marginBottom="15dp" />

            <Spinner
                android:id="@+id/spnDurum"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#121212"
                android:layout_marginBottom="25dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swYasakli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YASAKLI ARAÇ "
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:thumbTint="#FF5252"
                app:trackTint="#6A040F" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAracKaydet"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#6A040F"
                android:text="ARACI SİSTEME TANIMLA"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>