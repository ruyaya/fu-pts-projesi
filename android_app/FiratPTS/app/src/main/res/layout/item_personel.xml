<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#1E1E24"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivUserIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#8A8A8E" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/ivUserIcon"
            android:layout_toStartOf="@id/btnGorevliSil"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGorevliAdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Görevli Kullanıcı Adı"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGorevliRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Güvenlik Görevlisi"
                android:textColor="#00E676"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnGorevliSil"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D90429" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>